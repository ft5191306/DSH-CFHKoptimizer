{
  "name": "@local/dsh-cf-pin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "持续测量 open-design.ai 链路的 Cloudflare 边缘 IP，劣化时自动改写 hosts 优选段。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "lib/admin.js",
    "lib/config-store.js",
    "lib/engine.js",
    "lib/hosts.js",
    "lib/probe.js",
    "lib/types.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
